# KirimStellar frontend — environment
# Copy to .env and adjust as needed. All vars are optional; sensible testnet defaults apply.

# Horizon endpoint (testnet)
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Network: TESTNET or PUBLIC
VITE_STELLAR_NETWORK=TESTNET

# Asset that "Kirim" sends on-chain.
# Default is native XLM (works on testnet with no trustline setup).
# To send a custom asset, set CODE + ISSUER (both required) and ensure trustlines exist.
VITE_SEND_ASSET_CODE=XLM
VITE_SEND_ASSET_ISSUER=

# Display-only estimated conversion rate: 1 unit of send asset -> IDR.
# Used for the "mereka terima" estimate. Real DEX path-payment conversion is future work.
VITE_IDR_RATE=2500

# Soroban escrow contract id (set once deployed; unused until escrow wiring lands)
VITE_ESCROW_CONTRACT_ID=
